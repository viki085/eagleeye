# ── EagleEye Phase 0 configuration ─────────────────────────────
# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Infra (defaults match infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=eagleeye
S3_SECRET_KEY=eagleeye-local-secret

# Supabase local (from `npx supabase start` output)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Phase 1: auth + LLM ────────────────────────────────────────
# LLM_PROVIDER=openai               # anthropic | openai | ollama
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MODEL_FAST=gpt-6-luna             # guard, query rewrite, titles (defaults shown; ADR-29)
# MODEL_CAPABLE=gpt-6-luna          # answers, supervisor, SQL (default; ADR-30 eval)
# MODEL_CAPABLE=gpt-6.1-terra       # stronger, ~10× cost: use if complex-task answers degrade
# REASONING_EFFORT_FAST=none        # reasoning models only: none|minimal|low|medium|high
# REASONING_EFFORT_CAPABLE=none     # gpt-5-nano needs "minimal"; gpt-6.1-sol needs "low"+
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Organisation that admin-added users join (Clerk "membership required"). Leave empty to
# auto-detect; required only if the Clerk instance has more than one organisation.
CLERK_ORGANIZATION_ID=

# ── Phase 2: RAG ───────────────────────────────────────────────
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536                    # must match the vector(D) column + Qdrant collection

# Document chunking (chosen with evals/retrieval_eval.py, ADR-32). After changing these, re-chunk
# existing documents: uv run --package eagleeye-ingest-worker python -m ingest_worker.reindex --all
# CHUNK_SOFT_CHARS=1200
# CHUNK_MAX_CHARS=1600              # soft + overlap + 2 must fit within max
# CHUNK_OVERLAP_CHARS=200
# CHUNK_MIN_CHARS=400

# Rate limits (Redis fixed window; the limiter fails open if Redis is down)
# RATE_LIMIT_GENERAL_PER_MIN=300    # per signed-in user, all API calls
# RATE_LIMIT_MESSAGES_PER_MIN=20
# RATE_LIMIT_UPLOADS_PER_MIN=20
# RATE_LIMIT_IP_PER_MIN=600         # per client IP, before authentication
# MAX_STREAMS_PER_USER=4
# DOCS_BUCKET=eagleeye-local-docs
# MAX_UPLOAD_MB=25
# QDRANT_COLLECTION=enterprise_chunks
# ENTERPRISE_UPLOAD_OPEN=false      # default: only knowledge_admin/admin add/delete enterprise docs; true → everyone
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.25                # cosine floor for auto-grounding (no docs selected)

# ── Phase 3: agents ────────────────────────────────────────────
# MODEL_FAST_FALLBACK=gpt-4o-mini   # used once if the primary fails after retries
# MODEL_CAPABLE_FALLBACK=gpt-6.1-terra  # answers from a fallback are flagged "degraded"
# AGENT_MAX_STEPS=14                # supervisor LLM turns per run
# AGENT_MAX_TOOL_CALLS=12
# AGENT_MAX_COST_USD=0.25
# AGENT_MAX_SECONDS=120             # hard deadline = this + 30 s
# MAX_ACTIVE_RUNS_PER_USER=2
# USAGE_LIMIT_USD=500               # lifetime LLM spend per user; new messages refused beyond it
# MONTHLY_BUDGET_USD=100            # starting monthly LLM budget; admins change it in the console (stored in app_settings)
# EagleEye's own cache: safety checks, query rewrites, search embeddings, repeated company-document answers
# APP_CACHE_ENABLED=true
# APP_CACHE_TTL_S=86400

# ── Phase 4: text-to-SQL + data gateway ────────────────────────
# ENABLE_SQL=true                   # false → SQL tools and the sql route disappear
# WAREHOUSE_DSN=postgresql://eagleeye_ro:eagleeye-ro-local@127.0.0.1:5433/warehouse  # gateway only
# GATEWAY_URL=http://127.0.0.1:8100
# GATEWAY_HMAC_SECRET=              # required outside APP_ENV=local (shared by worker + gateway)
# ARTIFACTS_BUCKET=eagleeye-local-artifacts
# SQL_EXPLAIN_MAX_ROWS=5000000      # EXPLAIN pre-check: reject plans estimating more rows
# SQL_MAX_CONCURRENCY=4             # concurrent queries per data source

# ── Phase 5: data files, analysis sandbox, charts ──────────────
# Build the sandbox once: docker build -t eagleeye-sandbox:1 infra/sandbox
# ENABLE_ANALYSIS=true              # false → data files, analysis and chart tools disappear
# ENABLE_PYTHON_ANALYSIS=true       # false → DuckDB SQL only in the sandbox
# SANDBOX_IMAGE=eagleeye-sandbox:1  # missing image/Docker → analyze_data not offered
# SANDBOX_MEM_MB=1024               # per execution, no swap
# SANDBOX_TIMEOUT_S=60              # per execution; the container is killed after this
# SANDBOX_RUNS_PER_HOUR=60          # per user
# AGENT_MAX_SECONDS_ANALYSIS=240    # run deadline when analysis tools are available
# DATASET_MAX_ROWS=2000000
# DATASET_MAX_COLUMNS=200

# Shared public demo account (python -m app.demo setup|reset; sign-in page /demo)
DEMO_USERNAME=demouser1
DEMO_PASSWORD=
DEMO_USAGE_LIMIT_USD=1.0
DEMO_RESET_HOURS=24
# one email per new demo sign-in (Gmail: SMTP_USERNAME = your address, SMTP_PASSWORD = an app password)
DEMO_NOTIFY_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
# web (apps/web/.env.local): NEXT_PUBLIC_DEMO_USERNAME / NEXT_PUBLIC_DEMO_PASSWORD
