# ── EagleEye Phase 0 configuration ─────────────────────────────
# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Infra (defaults match infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=eagleeye
S3_SECRET_KEY=eagleeye-local-secret

# Supabase local (from `npx supabase start` output)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Phase 1: auth + LLM ────────────────────────────────────────
# LLM_PROVIDER=openai               # anthropic | openai | ollama
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MODEL_FAST=gpt-6-luna             # guard, query rewrite, titles (defaults shown; ADR-29)
# MODEL_CAPABLE=gpt-6.1-terra       # answers + supervisor (gpt-6-luna = cheapest option)
# REASONING_EFFORT_FAST=none        # reasoning models only: none|minimal|low|medium|high
# REASONING_EFFORT_CAPABLE=none     # gpt-5-nano needs "minimal"; gpt-6.1-sol needs "low"+
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Phase 2: RAG ───────────────────────────────────────────────
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536                    # must match the vector(D) column + Qdrant collection
# DOCS_BUCKET=eagleeye-local-docs
# MAX_UPLOAD_MB=25
# QDRANT_COLLECTION=enterprise_chunks
# ENTERPRISE_UPLOAD_OPEN=true       # false → only knowledge_admin/admin upload enterprise docs
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.25                # cosine floor for auto-grounding (no docs selected)

# ── Phase 3: agents ────────────────────────────────────────────
# MODEL_FAST_FALLBACK=gpt-4o-mini   # used once if the primary fails after retries
# MODEL_CAPABLE_FALLBACK=gpt-4o     # answers from a fallback are flagged "degraded"
# AGENT_MAX_STEPS=14                # supervisor LLM turns per run
# AGENT_MAX_TOOL_CALLS=12
# AGENT_MAX_COST_USD=0.25
# AGENT_MAX_SECONDS=120             # hard deadline = this + 30 s
# MAX_ACTIVE_RUNS_PER_USER=2
# USAGE_LIMIT_USD=500               # lifetime LLM spend per user; new messages refused beyond it

# ── Phase 4: text-to-SQL + data gateway ────────────────────────
# ENABLE_SQL=true                   # false → SQL tools and the sql route disappear
# WAREHOUSE_DSN=postgresql://eagleeye_ro:eagleeye-ro-local@127.0.0.1:5433/warehouse  # gateway only
# GATEWAY_URL=http://127.0.0.1:8100
# GATEWAY_HMAC_SECRET=              # required outside APP_ENV=local (shared by worker + gateway)
# ARTIFACTS_BUCKET=eagleeye-local-artifacts
# SQL_EXPLAIN_MAX_ROWS=5000000      # EXPLAIN pre-check: reject plans estimating more rows
# SQL_MAX_CONCURRENCY=4             # concurrent queries per data source
