# ── EagleEye Phase 0 configuration ─────────────────────────────
# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Infra (defaults match infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=eagleeye
S3_SECRET_KEY=eagleeye-local-secret

# Supabase local (from `npx supabase start` output)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Phase 1+ (leave empty for now) ─────────────────────────────
# LLM_PROVIDER=anthropic            # anthropic | openai | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MODEL_FAST=
# MODEL_CAPABLE=
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
