# container scripts must keep LF endings (sh in Linux images)
*.sh text eol=lf
infra/docker/* text eol=lf
# the demo machine boot script and compose files run on Linux
*.tftpl text eol=lf
infra/cloud/* text eol=lf
infra/warehouse/init/* text eol=lf
# documents and images are binary: never convert line endings
*.pdf binary
*.png binary
